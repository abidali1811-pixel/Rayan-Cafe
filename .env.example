# Copy this file to .env and fill in real values.
# Never commit .env.

FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=true

# mysql | postgres | sqlite (sqlite: tests or a quick local demo)
DB_ENGINE=postgres

# Used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hearth_steam
DB_USER=cafe_user
DB_PASSWORD=change-me

# Optional full URL overrides the pieces above.
# postgres: postgresql+psycopg://user:pass@localhost:5432/hearth_steam
# mysql:    mysql+pymysql://user:pass@localhost:3306/hearth_steam
# sqlite:   sqlite:///cafe.db
DATABASE_URL=

ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-admin-password

# OpenAI-compatible chat API (OpenAI, Groq, etc.)
AI_API_KEY=sk-your-key-here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
CHAT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
